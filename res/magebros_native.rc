// Icon and version information for MageBrosNative.exe. The icon is original artwork made for
// this project (sources: docs/branding/icon.svg and icon_small.svg). The game's own data is read
// at runtime from the original MageBros.exe and is not included here.
#include <winver.h>
#include "version.h"  // generated from the version in CMakeLists.txt

// The first icon resource becomes the program icon (Explorer, title bar and taskbar).
1 ICON "magebros_native.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MBN_VERSION_MAJOR,MBN_VERSION_MINOR,MBN_VERSION_PATCH,0
 PRODUCTVERSION MBN_VERSION_MAJOR,MBN_VERSION_MINOR,MBN_VERSION_PATCH,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Mage Bros. Native (requires original MageBros.exe)"
      VALUE "FileVersion", MBN_VERSION_STRING
      VALUE "ProductName", "Mage Bros. Native"
      VALUE "ProductVersion", MBN_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
